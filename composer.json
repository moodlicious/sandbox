{
  "name": "moodle/seed",
  "description": "A Composer project template to seed a new Moodle Site",
  "type": "project",
  "require": {
    "php": "^8.4",
    "moodle/composer-installer": "*",
    "moodle/moodle-composer-scaffold": "*",
    "moodle/moodle": "5.2.2",
    "moodlicious/moodle-dataformat_sqlite": "dev-main",
    "moodlicious/moodle-dataformat_jsonl": "dev-main",
    "moodlicious/moodle-local_wayfinder": "0.0.1",
    "moodlicious/moodle-local_lumens": "0.0.1"
  },
  "repositories": [
    {
      "name": "Moodle Package Repository",
      "type": "composer",
      "url": "https://moodle.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "moodle/composer-installer": true,
      "moodle/moodle-composer-scaffold": true
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "platform": {
      "php": "8.4"
    }
  }
}
